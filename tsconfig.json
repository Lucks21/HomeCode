{
  "compilerOptions": {
    // Module system - CommonJS to match "type": "commonjs" in package.json
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    // Output
    "outDir": "./dist",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // NestJS decorator support
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    // React JSX support
    "jsx": "react-jsx",

    // Type checking
    "strict": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    // Path aliases para el frontend web
    "baseUrl": ".",
    "paths": {
      "@/*": ["web/src/*"]
    }
  },
  "include": ["src/**/*", "app/src/**/*", "web/src/**/*"],
  "exclude": ["node_modules", "dist"]
}
